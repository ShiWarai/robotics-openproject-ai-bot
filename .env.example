# cp .env.example .env

OP_API_URL=https://address.ru/api/v3
OP_API_KEY=
TELEGRAM_TOKEN=

RKLLAMA_URL=http://rkllama:8080
RKLLAMA_MODEL=qwen3-4b
RKLLAMA_THINKING=true
RKLLAMA_TEMPERATURE=0.7
RKLLAMA_MAX_NEW_TOKENS=4096

# Whisper RKNN (https://github.com/ShiWarai/whisper-rknn), сеть whisper_rknn_default
WHISPER_RKNN_URL=http://whisper-rknn-api:9003
# Если в whisper-rknn задан WHISPER_API_KEY — тот же ключ здесь (Bearer)
# WHISPER_API_KEY=
